import pandas as pd
import numpy as np

try:
    df = pd.read_csv("data/trends_clean.csv")
except Exception as e:
    print(e)
    exit()

print(f"DataFrame Shape (Rows, Columns): {df.shape}")
print(df.head())
avg_score = df["score"].mean()
avg_comments = df["num_comments"].mean()
print(f"Avg Story Score: {avg_score:.2f}")
print(f"Avg No of Comments: {avg_comments:.2f}")
print(f"Mean value: {np.mean(df['score']):.2f}")
print(f"Median : {np.median(df['score']):.2f}")
print(f"Standard Deviation : {np.std(df['score']):.2f}")
print(f"Maximum Score: {np.max(df['score'])}")
print(f"Minimum Score: {np.min(df['score'])}")
most_common_category = df["category"].value_counts().idxmax()
print(f"Category with the most stories: {most_common_category.upper()}")
top_commented_row = df.loc[df["num_comments"].idxmax()]
print(f"Most commented story: '{top_commented_row['title']}'")
print(f" -> Written by: {top_commented_row['author']} with {top_commented_row['num_comments']} comments.")
df["engagement"] = df["num_comments"] / (df["score"] + 1)
df["is_popular"] = df["score"] > avg_score
df.to_csv("data/trends_analysed.csv", index=False)
