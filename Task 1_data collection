import json
import requests
import os # Import the os module

TOP_STORIES_URL = "https://hacker-news.firebaseio.com/v0/topstories.json"
ITEM_URL = "https://hacker-news.firebaseio.com/v0/item/{}.json"

KEYWORDS = {
    "technology": ["ai", "software", "computer", "programming", "chip", "cloud", "tech", "code", "dev", "app", "web", "linux", "server", "data", "google", "apple", "microsoft", "python"],
    "worldnews": ["election", "government", "war", "president", "policy", "china", "court", "news", "world", "state", "city", "law", "police", "country", "border", "protest", "europe", "uk"],
    # Added broad terms like 'out', 'play', 'top', 'new', 'final'
    "sports": ["football", "cricket", "tennis", "basketball", "olympics", "game", "match", "run", "player", "sport", "win", "team", "racing", "ball", "chess", "league", "cup","lose","hockey",  "athlete", "club", "play", "out", "top", "final", "score"],
    # Added broad terms like 'tech', 'dna', 'lab', 'new', 'test', 'dr', 'health', 'medical'
    "science": ["research", "nasa", "space", "physics", "biology", "climate", "earth", "science", "moon", "energy", "solar", "nature", "study", "mars", "quantum", "dna", "ocean", "star", "brain", "lab", "test","global warming", "health", "medical", "doctor", "dr"],
    "entertainment": ["movie", "music", "actor", "film", "tv", "nintendo", "hollywood", "art", "book", "video", "song", "audio", "show", "game", "anime", "novel", "theater", "studio", "pop", "retro", "stream", "player", "design", "fiction", "history", "Kollywood", "Hollywood"]
}

id_list = requests.get(TOP_STORIES_URL).json()[:500]

collected_stories = []
category_counts = {"technology": 0, "worldnews": 0, "sports": 0, "science": 0, "entertainment": 0}

for story_id in id_list:
    
    if all(count >= 25 for count in category_counts.values()):
        break

    try:
       
        story = requests.get(ITEM_URL.format(story_id), timeout=5).json()
        title = story.get("title", "")
        title_lower = title.lower()
        for category, keywords_list in KEYWORDS.items():
            if any(word in title_lower for word in keywords_list):
                if category_counts[category] < 25:
                    clean_record = {
                        "post_id": story.get("id"),
                        "title": title,
                        "category": category,
                        "score": story.get("score", 0),
                        "num_comments": story.get("descendants", 0),
                        "author": story.get("by", "Unknown")
                    }

                    collected_stories.append(clean_record)
                    category_counts[category] += 1
                    print(f" Saved [{category.upper()}]: {title[:40]}...")
                    break 
                    
    except Exception:
        continue 
      
os.makedirs('data', exist_ok=True)
with open("data/trends_raw.json", "w", encoding="utf-8") as file:
    json.dump(collected_stories, file, indent=4)

print("story counts per category:", category_counts)
print(f"Total stories collected: {len(collected_stories)}")
